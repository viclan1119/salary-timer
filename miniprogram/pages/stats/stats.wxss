.page {
  padding-bottom: 40rpx;
}

/* 汇总卡片（毛玻璃） */
.summary {
  display: flex;
  margin: 24rpx 32rpx;
}
.summary-box {
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 8rpx 32rpx rgba(31, 41, 55, 0.08);
}
.summary-box + .summary-box {
  margin-left: 20rpx;
}
.summary-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
}
.summary-label .en {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  color: #8aa0b8;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-top: 2rpx;
}
.summary-val {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #10b981;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}
.summary-sub {
  display: block;
  font-size: 22rpx;
  color: #8aa0b8;
  margin-top: 6rpx;
}

/* 历史记录 */
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.4);
}
.history-item:last-child {
  border-bottom: none;
}
.history-left {
  display: flex;
  flex-direction: column;
}
.history-date {
  color: #475569;
  font-size: 28rpx;
  font-weight: 600;
}
.history-work {
  color: #8aa0b8;
  font-size: 24rpx;
  margin-top: 4rpx;
}
.history-earned {
  font-weight: 700;
  color: #10b981;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
}

.empty {
  text-align: center;
  color: #8aa0b8;
  font-size: 26rpx;
  padding: 40rpx 0;
  line-height: 1.6;
}
