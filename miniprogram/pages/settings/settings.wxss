.page {
  padding-bottom: 60rpx;
}

/* 分段选择器 */
.seg {
  display: flex;
  background: rgba(148, 163, 184, 0.18);
  border-radius: 16rpx;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #64748b;
  border-radius: 12rpx;
  letter-spacing: 1rpx;
}
.seg-item.active {
  background: #ffffff;
  color: #10b981;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.4);
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 250rpx;
  color: #475569;
  font-size: 28rpx;
}
.form-label .en {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  color: #8aa0b8;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-top: 2rpx;
}
.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 600;
}
.form-unit {
  width: 90rpx;
  text-align: right;
  color: #8aa0b8;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.card-unit {
  font-size: 22rpx;
  color: #8aa0b8;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 600;
}

/* 模块 */
.module-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.4);
}
.module-name-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}
.module-amount-box {
  display: flex;
  align-items: center;
}
.module-amount-input {
  width: 180rpx;
  text-align: right;
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 600;
}
.module-rm {
  width: 56rpx;
  text-align: center;
  color: #f87171;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.module-empty {
  color: #8aa0b8;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.add-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.add-btn {
  font-size: 24rpx;
  color: #10b981;
  border: 2rpx solid rgba(16, 185, 129, 0.4);
  background: rgba(16, 185, 129, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.4);
}
.total-label {
  color: #475569;
  font-size: 28rpx;
}
.total-label .en {
  font-size: 18rpx;
  font-weight: 600;
  color: #8aa0b8;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-left: 6rpx;
}
.total-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #10b981;
  font-variant-numeric: tabular-nums;
}

.btn-primary {
  background: linear-gradient(90deg, #10b981, #059669);
  color: #ffffff;
  margin-top: 20rpx;
}
